{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-agency-mvp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",

  /* The workers.dev subdomain is disabled: it served the same thing as the
     final domain, with no redirect and no canonical of its own. Three URLs for
     one piece of content is duplicate content — and this was the one the
     canonicals pointed at. Cutting it beats maintaining a redirect. */
  "workers_dev": false,

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // Next exports each page as <route>/index.html (trailingSlash: true).
    // `auto-trailing-slash` serves /a-propos/ from a-propos/index.html and
    // redirects /a-propos to the slashed form — one URL per page, so no
    // duplicate content in Google's eyes.
    "html_handling": "auto-trailing-slash",

    // An unknown address renders out/404.html with a real 404 status, not the
    // home page with a 200: a crawler must be able to tell the difference.
    "not_found_handling": "404-page",

    // Without this the quote form cannot work in a browser. Submitting a form
    // is a navigation request (Sec-Fetch-Mode: navigate); the static-asset
    // layer intercepts those to answer with an HTML page, and refuses anything
    // that is not a GET with a 405 — without ever waking the Worker.
    //
    // The fault is invisible from the command line: no HTTP client sends that
    // header, so the same POST passes perfectly from curl and fails from
    // Chrome.
    //
    // It used to be an allow-list of three routes. Every other address was
    // answered by the asset layer without the Worker ever running, which is why
    // `Accept: text/markdown` could not be honoured: the code deciding it was
    // never reached. The list is now an exclude-list, so pages pass through the
    // Worker and the bulk — build output and photographs, which have nothing to
    // negotiate — still does not.
    //
    // The cost is one Worker invocation per page view, and the risk is that an
    // exception there is now a blank site rather than a blank header. Both
    // worker/markdown.ts entry points therefore catch and fall back to the
    // untouched asset.
    "run_worker_first": ["/*", "!/_next/*", "!/photos/*", "!/admin/*"]
  },

  // The form's honeypot stops naive bots; this stops someone aiming at the
  // agency's inbox or at the free sending quota.
  "ratelimits": [
    { "name": "DEVIS_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },

    // A separate and much wider limit: a click is ordinary where a form
    // submission is not. It protects no real visitor, it only stops someone
    // manufacturing a number in bursts — and a manufactured number would ruin
    // the whole point of this ledger.
    { "name": "CLIC_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // Contact-intent ledger. To recreate it elsewhere:
  //   npx wrangler d1 create travel-clics
  // then apply the schema:
  //   npx wrangler d1 execute travel-clics --remote --file=migrations/0001_contact_click.sql
  //
  // D1 rather than Analytics Engine because Analytics Engine keeps only 90
  // days: a commission disagreement often concerns a quarter already closed,
  // and a ledger that erases itself before the conversation is worthless.
  "d1_databases": [
    {
      "binding": "CLICS",
      "database_name": "travel-clics",
      "database_id": "d68c217d-9e55-4899-a650-089315d2d0f7"
    }
  ],

  // 16:00 UTC = 23:00 in Vietnam. The digest therefore arrives at the end of
  // the local day, once it is complete, rather than in the middle of it.
  "triggers": {
    "crons": ["0 16 * * *"]
  },

  "vars": {
    // Sender. The domain is verified at Resend (DKIM at resend._domainkey,
    // SPF on the send. subdomain), so mail now leaves under the site's own
    // name instead of Resend's sandbox address.
    "DEVIS_FROM": "Jasmin Travel <contact@voyagevietnam-surmesure.com>",

    // Inbox for incoming requests.
    //
    // This was the Gmail address directly, and for a good reason at the time:
    // contact@ was then a Cloudflare Email Routing rule forwarding to that same
    // Gmail, so sending a lead through it added a hop and a failure point
    // between a prospect and the only copy of their request, and bought nothing.
    //
    // That stopped being true on 11 November 2026. contact@ is now a real
    // mailbox at the domain's own host, with its own storage, and it keeps a
    // copy while forwarding to the Gmail. The hop now buys the one thing the
    // Gmail could never give: a record that can be handed over. The day the
    // agency answers its own leads, or someone is hired to, they get the mailbox
    // and its history — not the owner's personal account.
    //
    // The forward is what keeps the phone notifications, so nothing is lost on
    // the way in. If it is ever switched off, leads still arrive — they simply
    // stop appearing on the phone.
    "DEVIS_TO": "contact@voyagevietnam-surmesure.com"
  },

  // RESEND_API_KEY is not here: it is a secret.
  //   npx wrangler secret put RESEND_API_KEY
  // Locally, put it in .dev.vars (git-ignored).
  //
  // Same for TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID, used by the daily digest.

  "observability": { "enabled": true }
}
