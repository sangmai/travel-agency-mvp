{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-agency-mvp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",

  /* Le sous-domaine workers.dev est désactivé : il servait la même chose que
     le domaine définitif, sans redirection ni canonique propre. Trois URL
     pour un même contenu, c'est du contenu dupliqué — et c'était celle-ci
     que les canoniques désignaient. La couper vaut mieux qu'une redirection
     à entretenir. */
  "workers_dev": false,

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // Next exporte chaque page en <route>/index.html (trailingSlash: true).
    // `auto-trailing-slash` sert /a-propos/ depuis a-propos/index.html et
    // redirige /a-propos vers la forme avec barre — une seule URL par page,
    // donc pas de contenu dupliqué aux yeux de Google.
    "html_handling": "auto-trailing-slash",

    // Une adresse inconnue rend out/404.html avec un vrai statut 404, et non
    // la page d'accueil en 200 : un crawler doit pouvoir faire la différence.
    "not_found_handling": "404-page",

    // Sans ceci, le formulaire de devis ne peut pas fonctionner dans un
    // navigateur. L'envoi d'un formulaire est une requête de navigation
    // (Sec-Fetch-Mode: navigate) ; le service de fichiers statiques les
    // intercepte pour y répondre par une page HTML, et refuse par un 405 tout
    // ce qui n'est pas un GET — sans jamais réveiller le Worker.
    //
    // Le défaut est invisible en ligne de commande : aucun client HTTP
    // n'envoie cet en-tête, donc le même POST passe parfaitement depuis curl
    // et échoue depuis Chrome.
    "run_worker_first": ["/api/*", "/auth", "/callback"]
  },

  // Le honeypot du formulaire arrête les robots naïfs ; ceci arrête quelqu'un
  // qui vise la boîte de réception de l'agence ou le quota d'envoi gratuit.
  "ratelimits": [
    { "name": "DEVIS_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "vars": {
    // Expéditeur. onboarding@resend.dev est l'adresse de test de Resend, la
    // seule autorisée tant qu'aucun domaine n'est vérifié. À remplacer par
    // « Jasmine Travel <devis@votre-domaine.fr> » une fois le domaine vérifié.
    "DEVIS_FROM": "Jasmine Travel <onboarding@resend.dev>",

    // Boîte de réception des demandes — pas l'adresse publique du site.
    // En mode test, Resend n'accepte comme destinataire que l'adresse du
    // compte : la changer ici sans vérifier de domaine fait refuser tous les
    // envois. Le voyageur, lui, n'est jamais destinataire, seulement Reply-To,
    // ce que Resend autorise. C'est ce qui permet au formulaire de fonctionner
    // pour de vrais visiteurs avant même d'avoir un domaine.
    "DEVIS_TO": "maisang90dn@gmail.com"
  },

  // RESEND_API_KEY n'est pas ici : c'est un secret.
  //   npx wrangler secret put RESEND_API_KEY
  // En local, le mettre dans .dev.vars (ignoré par git).

  "observability": { "enabled": true }
}
